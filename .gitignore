# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Operating-system and editor files.
.DS_Store
._*
*.swp
*.swo
*~
/.idea/
/.vscode/
/.ruby-lsp/

# Ignore bundler config.
/.bundle
/vendor/bundle

# Ignore test, documentation, and linter caches.
/coverage
/.yardoc
/.rubocop-*

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
*.log
*.pid
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore SQLite databases and their journal files regardless of location.
*.sqlite3
*.sqlite3-*

# Ignore compiled assets; source assets remain tracked.
/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

/AGENTS.md
/artifacts/
/docs/screenshots/
