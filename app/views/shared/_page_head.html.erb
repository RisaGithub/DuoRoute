<div class="page-head">
  <div class="page-head__copy">
    <p class="eyebrow"><%= local_assigns[:eyebrow] %></p>
    <h1><%= icon_label(title, section_icon) %></h1>
    <% if local_assigns[:subtitle] %><p class="page-head__sub"><%= subtitle %></p><% end %>
  </div>
  <% if local_assigns[:run_selector] && @completed_runs.any? %>
    <%= render "shared/run_selector" %>
  <% elsif local_assigns[:action_label] %><%= link_to icon_label(action_label), action_path, class: "btn btn--primary" %><% end %>
</div>
