<%= form_with url: controller_name == "providers" ? providers_path : request.path, method: :get, class: "run-selector", data: { controller: "run-selector", turbo: false } do %>
  <label class="field"><span><%= icon_label("Выбранный запуск") %></span><%= select_tag :run_id, options_for_select(@completed_runs.map { |run| ["#{run.name} · #{l(run.completed_at || run.created_at, format: '%d.%m.%Y %H:%M')} · #{run.preset} · #{run.status}", run.id] }, @run&.id), class: "select", data: { action: "change->run-selector#change" } %></label>
<% end %>
