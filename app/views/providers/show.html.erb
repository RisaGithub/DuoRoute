<%= render "shared/page_head", eyebrow: "Provider drill-down", title: @provider["payment_system"], subtitle: "Snapshot limits, фактическое распределение и наблюдаемая успешность.", run_selector: true %>
<section class="kpis kpis--4"><article class="kpi card"><span><%= icon_label("Conversion") %></span><strong><%= pct(@provider["conversion_24h"].to_f * 100) %></strong></article><article class="kpi card"><span><%= icon_label("Count факт / цель") %></span><strong><%= pct(@distribution["share_pct"]) %> / <%= pct(@distribution["target_pct"] || @provider["traffic_percentage"]) %></strong></article><article class="kpi card"><span><%= icon_label("Volume факт") %></span><strong><%= pct(@volume["share_pct"]) %></strong></article><article class="kpi card"><span><%= icon_label("Success") %></span><strong><%= pct(@performance["success_rate_pct"]) %></strong></article></section>
<section class="grid grid--2"><article class="card panel"><div class="section-head"><h2><%= icon_label("Capacity") %></h2></div><% [["Daily", @capacity["daily_utilization_pct"]], ["In-progress count", @capacity["in_progress_count_utilization_pct"]], ["In-progress amount", @capacity["in_progress_amount_utilization_pct"]]].each do |label, value| %><div class="meter"><div><span><%= label %></span><b><%= pct(value) %></b></div><div class="util"><span style="width:<%= [value.to_f, 100].min %>%"></span></div></div><% end %></article><article class="card panel"><div class="section-head"><h2><%= icon_label("Параметры") %></h2></div><dl class="kv"><% @provider.each do |key, value| %><dt><%= key %></dt><dd class="mono"><%= value.is_a?(Array) ? (value.empty? ? "без ограничений" : value.join(", ")) : value.inspect %></dd><% end %></dl></article></section>

<section class="card panel"><%= render "metrics", provider: @provider, run: @run %></section>
