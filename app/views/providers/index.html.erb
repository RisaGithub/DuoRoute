<%= render "shared/page_head", eyebrow: "Snapshot запуска", title: "Провайдеры", subtitle: "Настройки и результаты выбранного запуска. Approval — успешные попытки; Latency — среднее время ответа провайдера.", run_selector: true %>
<% if @run %>
  <div class="provider-overview-grid">
    <% @providers.each_with_index do |provider, index| %>
      <%= render "overview_card", provider: provider, run: @run, index: index %>
    <% end %>
  </div>
<% else %><section class="empty-state card"><p>Завершённых запусков пока нет.</p><%= link_to icon_label("Новый запуск"), new_run_path, class: "btn btn--primary" %></section><% end %>
