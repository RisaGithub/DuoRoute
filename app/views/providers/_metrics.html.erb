<% name = provider["payment_system"]; report = run.report; count = report.dig("distribution", name) || {}; volume = report.dig("volume_distribution", name) || {}; performance = report.dig("provider_performance", name) || {}; capacity = report.dig("capacity_utilization", name) || {} %>
<% if name == "spacepayments" %><p class="hint">Резервный self-provider: используется только после исчерпания внешних вариантов.</p><% end %>
<dl class="kv">
<% {"Назначено операций" => count["count"], "Общая сумма" => money(volume["amount"]), "Доля количества: цель / факт" => "#{pct(count['target_pct'])} / #{pct(count['share_pct'])}", "Доля суммы: цель / факт" => "#{pct(volume['target_pct'])} / #{pct(volume['share_pct'])}", "Approval попыток" => pct(performance["success_rate_pct"]), "Reject / Expired" => "#{performance.dig('results', 'rejected') || 0} / #{performance.dig('results', 'expired') || 0}", "Latency попыток, с" => performance["average_latency_sec"], "Попытки" => performance["attempts"], "Fallback" => run.decisions.count { |decision| decision["selected_provider"] == name && decision["fallback_used"] }, "Дневной оборот до / после" => "#{money(capacity['daily_start'])} / #{money(capacity['daily_used'])}", "Дневной лимит" => capacity["daily_limit"] || "∞", "Загрузка дневного лимита" => pct(capacity["daily_utilization_pct"]), "Заявки в работе" => capacity["in_progress_count_end"], "Доступные реквизиты" => provider["available_requisites"], "Банки" => provider.fetch("banks", []).join(", ").presence || "Все", "Исключить перечисленные банки" => provider["exclude_banks"] ? "да" : "нет", "Диапазон сумм" => "#{provider['limit_amount_min'] || 0} – #{provider['limit_amount_max'] || '∞'}", "Маржа провайдера, %" => provider["provider_margin_pct"], "Лимит запросов в минуту" => run.config.dig("provider_overrides", name, "requests_per_minute_limit") || provider["requests_per_minute_limit"] || "∞"}.each do |label, value| %><dt><%= label %></dt><dd><%= value %></dd><% end %>
</dl>
<details><summary><%= icon_label("Причины исключения", "settings") %></summary><% run.decisions.flat_map { |decision| decision["attempts"] }.select { |attempt| attempt["provider"] == name && attempt["decision"] == "skipped" }.map { |attempt| attempt["reason"] }.tally.sort_by { |_, value| -value }.each do |reason, count| %><p><code><%= reason %></code>: <%= count %></p><% end %></details>
