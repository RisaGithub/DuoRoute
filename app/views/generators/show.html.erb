<%= render "shared/page_head", eyebrow: "Synthetic lab", title: "Генератор данных", subtitle: "Reproducible normal, conflict, failure, timeout, invalid и stress сценарии." %>
<% if @issues.present? %><div class="alert alert--error"><% @issues.each do |issue| %><p><code><%= issue.path %></code> — <%= issue.message %></p><% end %></div><% end %>
<%= form_with url: generator_path, class: "card panel", data: { turbo: false } do %><div class="form-grid form-grid--4"><label class="field"><span><%= icon_label("Scenario") %></span><%= select_tag :scenario, options_for_select(DuoRoute::Generators::Scenario::NAMES, @defaults[:scenario]), class: "select" %></label><label class="field"><span><%= icon_label("Operations") %></span><%= number_field_tag :operations, @defaults[:operations], min: 1, max: 20000, class: "input" %></label><label class="field"><span><%= icon_label("Providers") %></span><%= number_field_tag :providers, @defaults[:providers], min: 1, max: 50, class: "input" %></label><label class="field"><span><%= icon_label("Seed") %></span><%= number_field_tag :seed, @defaults[:seed], min: 0, class: "input" %></label></div><div class="toolbar"><button name="commit_action" value="preview" class="btn"><%= icon_label("Preview") %></button><button name="commit_action" value="download" class="btn"><%= icon_label("Скачать bundle") %></button><button name="commit_action" value="run" class="btn btn--primary"><%= icon_label("Запустить сейчас") %></button></div><p class="hint"><code>invalid_data</code> намеренно создаёт ошибки validator и не маскируется под успешный run.</p><% end %>
<% if @bundle %><section class="grid grid--3"><article class="kpi card"><span><%= icon_label("Providers") %></span><strong><%= @bundle["providers"]["providers"].length %></strong></article><article class="kpi card"><span><%= icon_label("Operations") %></span><strong><%= @bundle["operations"].length %></strong></article><article class="kpi card"><span><%= icon_label("Seed") %></span><strong><%= @bundle.dig("manifest", "seed") %></strong></article></section><details class="card raw" open><summary><%= icon_label("Первые операции", "settings") %></summary><pre class="json"><%= JSON.pretty_generate(@bundle["operations"].first(5)) %></pre></details><% end %>
