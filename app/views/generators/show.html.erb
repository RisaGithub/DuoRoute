<%= render "shared/page_head", eyebrow: "Лаборатория маршрутизации", title: "Генератор данных", subtitle: "Подготовьте воспроизводимый сценарий: от обычного потока до таймаутов и исчерпания лимитов." %>
<% if @issues.present? %><div class="alert alert--error" role="alert"><strong>Проверьте параметры и данные</strong><ul><% @issues.each do |issue| %><li><code><%= issue.path %></code> — <%= issue.message %></li><% end %></ul></div><% end %>
<%= form_with url: generator_path, class: "card panel generator-form", data: { turbo: false } do %>
  <div class="section-head"><div><p class="eyebrow">01 · Сценарий</p><h2>Что будем проверять?</h2></div><span class="pill pill--info">8 сценариев</span></div>
  <fieldset class="choice-fieldset"><legend class="hint">Выберите условия эксперимента</legend><div class="choice-grid choice-grid--4">
    <% generator_scenarios.each do |name, (title, description)| %><label class="choice-card"><%= radio_button_tag :scenario, name, @defaults[:scenario] == name, required: true %><span><strong><%= title %></strong><small><%= description %></small></span></label><% end %>
  </div></fieldset>
  <div class="generator-parameters"><div><p class="eyebrow">02 · Масштаб</p><h2>Размер набора</h2><p class="hint">К внешним провайдерам добавится один резервный.</p></div><div class="form-grid form-grid--3">
    <label class="field"><span>Операции</span><%= number_field_tag :operations, @defaults[:operations], min: 1, max: 20000, required: true, class: "input mono" %><small class="hint">От 1 до 20 000</small></label>
    <label class="field"><span>Внешние провайдеры</span><%= number_field_tag :providers, @defaults[:providers], min: 1, max: 50, required: true, class: "input mono" %><small class="hint">От 1 до 50 + резерв</small></label>
    <label class="field"><span>Seed</span><%= number_field_tag :seed, @defaults[:seed], min: 0, required: true, class: "input mono" %><small class="hint">Сохраните для повторения</small></label>
  </div></div>
  <div class="experiment-actions"><p class="hint">Сначала посмотрите набор или сразу запустите<br>сбалансированную стратегию с заданными исходами.</p><div class="toolbar"><button name="commit_action" value="download" class="btn">Скачать JSON</button><button name="commit_action" value="run" class="btn">Создать запуск ↗</button><button name="commit_action" value="preview" class="btn btn--primary">Сформировать предпросмотр</button></div></div>
  <p class="hint">«Ошибки в данных» можно просмотреть и скачать. Запуск будет остановлен валидацией.</p>
<% end %>
<% if @bundle %>
  <section class="generator-result"><div class="section-head"><div><p class="eyebrow">Набор сформирован</p><h2><%= generator_scenarios.dig(@bundle.dig("manifest", "scenario"), 0) %></h2><p class="hint">Предпросмотр соответствует параметрам последней отправки формы.</p></div><span class="pill pill--info">Seed <%= @bundle.dig("manifest", "seed") %></span></div>
    <div class="grid grid--3"><article class="kpi card"><span>Операции</span><strong><%= number_with_delimiter(@bundle["operations"].length, delimiter: " ") %></strong><small>В очереди на маршрутизацию</small></article><article class="kpi card"><span>Провайдеры</span><strong><%= @bundle["providers"]["providers"].length %></strong><small>Включая резервного</small></article><article class="kpi card"><span>История</span><strong><%= @bundle["history"].length %></strong><small>Записей в наборе</small></article></div>
    <div class="card table-wrap"><table><caption>Первые <%= [5, @bundle["operations"].length].min %> операций</caption><thead><tr><th>Операция</th><th>Создана</th><th>Банк</th><th class="num">Сумма, ₽</th></tr></thead><tbody><% @bundle["operations"].first(5).each do |operation| %><tr><td class="mono"><%= operation["operation_id"] %></td><td><%= operation["created_at"] %></td><td><%= operation["bank"] %></td><td class="num"><%= number_with_delimiter(operation["amount"], delimiter: " ") %></td></tr><% end %></tbody></table></div>
    <details class="card panel raw"><summary>Исходный JSON · первые 5 операций</summary><pre class="json"><%= JSON.pretty_generate(@bundle["operations"].first(5)) %></pre></details>
  </section>
<% else %>
  <div class="card panel experiment-empty"><span>✳</span><div><strong>Ваш тестовый набор появится здесь</strong><p>Провайдеры, очередь операций, история и заданные исходы — в одном JSON-файле.</p></div></div>
<% end %>
