<%= render "shared/page_head", eyebrow: "Counterfactual simulation", title: "Стратегии", subtitle: "Один snapshot и одна очередь; каждый preset стартует с чистого состояния." %>

<section class="provider-grid strategy-grid">
<% DuoRoute::StrategyCatalog.all.each do |name, strategy| %>
  <article class="card panel strategy-card"><h2><%= icon_label(strategy["title"]) %></h2><code><%= name %></code><p><%= strategy["description"] %></p><p><%= strategy["example"] %></p><details><summary><%= icon_label("Параметры и значения по умолчанию", "settings") %></summary><pre class="code-input"><%= DuoRoute.pretty_json(strategy.slice("weights", "policy_priorities", "parameters")) %></pre><p>Если параметр не переопределён, используется значение из загруженного providers.json.</p></details><%= link_to icon_label("Использовать в новом запуске"), new_run_path(preset: name), class: "btn" %></article>
<% end %>
</section>
<%= form_with url: compare_strategies_path, class: "card panel strategy-form", data: { turbo: false } do %><div class="section-head"><div><h2><%= icon_label("Сравнить стратегии") %></h2><p class="hint">Это what-if, а не изменение исторических фактов.</p></div><%= button_tag icon_label("Запустить сравнение"), type: "submit", class: "btn btn--primary" %></div><div class="preset-grid"><% DuoRoute::StrategyCatalog.all.each do |name, preset| %><label class="preset"><%= check_box_tag "presets[]", name, %w[count_share cascade conversion].include?(name) %><span><strong><%= name %></strong><small><%= preset.fetch("weights").map { |k,v| "#{k}×#{v}" }.join(" · ") %></small></span></label><% end %></div><label class="field field--small"><span><%= icon_label("Seed") %></span><%= number_field_tag :seed, 42, class: "input" %></label><% end %>
<% if @comparison %><section><div class="section-head"><h2><%= icon_label("Компромиссы стратегий") %></h2></div><div class="table-wrap card"><table><thead><tr><th>Preset</th><th class="num">Approval</th><th class="num">Fallback</th><th class="num">Latency</th><th class="num">Σ count deviation</th><th class="num">Σ volume deviation</th></tr></thead><tbody><% @comparison.each do |row| report = row[:report] %><tr><td class="mono"><%= row[:name] %></td><td class="num"><%= pct(report["approval_rate_pct"]) %></td><td class="num"><%= pct(report["fallback_rate_pct"]) %></td><td class="num"><%= report["average_latency_sec"] %>с</td><td class="num"><%= report["distribution"].values.sum { |v| v["deviation_pp"].abs }.round(1) %> п.п.</td><td class="num"><%= report["volume_distribution"].values.sum { |v| v["deviation_pp"].to_f.abs }.round(1) %> п.п.</td></tr><% end %></tbody></table></div></section><% end %>
<section class="card panel"><div class="section-head"><h2><%= icon_label("Формальный выбор") %></h2></div><p class="formula">score(provider) = Σ scoreᵢ(projected state) × weightᵢ / Σ weightᵢ</p><p>Hard constraints всегда применяются до scoring. При равном combined score сравниваются policy priorities, затем <code>provider.priority</code>, затем стабильный <code>payment_system</code>. Случайность не участвует в выборе.</p></section>
