<% comparing = action_name == "compare" %>
<header class="strategy-page-head">
  <p class="eyebrow">Настройки маршрутизации</p>
  <div class="strategy-page-head__row">
    <h1><%= icon_label("Стратегии", "strategy") %></h1>
<nav class="strategy-tabs" aria-label="Разделы стратегий">
  <%= link_to strategies_path, class: class_names("strategy-tab", "strategy-tab--active": !comparing), aria: { current: comparing ? nil : "page" } do %>
    <%= icon_label("Доступные стратегии", "strategy") %><span class="strategy-tab__count"><%= @strategies.length %></span>
  <% end %>
  <%= link_to icon_label("Сравнение стратегий", "compare"), compare_strategies_path, class: class_names("strategy-tab", "strategy-tab--active": comparing), aria: { current: comparing ? "page" : nil } %>
</nav>
  </div>
  <p class="page-head__sub">Семь стратегий и их параметры по умолчанию. Сохранённые значения используются в новых запусках и сравнении.</p>
</header>

<% if flash[:notice] %><p class="alert" role="status"><%= flash[:notice] %></p><% end %>
<% if @errors.present? %>
  <div class="alert alert--error" role="alert"><strong>Проверьте параметры</strong><ul><% @errors.each do |error| %><li><%= error %></li><% end %></ul></div>
<% end %>
<% if comparing %>
  <%= render "comparison" %>
<% else %>
  <%= render "available" %>
<% end %>
