<%= render "shared/page_head", eyebrow: "Counterfactual simulation", title: "Strategy Lab", subtitle: "Один snapshot и одна очередь; каждый preset стартует с чистого состояния." %>
<%= form_with url: compare_strategies_path, class: "card panel strategy-form", data: { turbo: false } do %><div class="section-head"><div><h2>Сравнить presets</h2><p class="hint">Это what-if, а не изменение исторических фактов.</p></div><%= submit_tag "Запустить сравнение", class: "btn btn--primary" %></div><div class="preset-grid"><% @config.fetch("presets").each do |name, preset| %><label class="preset"><%= check_box_tag "presets[]", name, %w[balanced cascade conversion_first load_safe].include?(name) %><span><strong><%= name %></strong><small><%= preset.fetch("weights").map { |k,v| "#{k}×#{v}" }.join(" · ") %></small></span></label><% end %></div><label class="field field--small"><span>Seed</span><%= number_field_tag :seed, 42, class: "input" %></label><% end %>
<% if @comparison %><section><div class="section-head"><h2>Компромиссы стратегий</h2></div><div class="table-wrap card"><table><thead><tr><th>Preset</th><th class="num">Approval</th><th class="num">Fallback</th><th class="num">Latency</th><th class="num">Σ count deviation</th><th class="num">Σ volume deviation</th></tr></thead><tbody><% @comparison.each do |row| report = row[:report] %><tr><td class="mono"><%= row[:name] %></td><td class="num"><%= pct(report["approval_rate_pct"]) %></td><td class="num"><%= pct(report["fallback_rate_pct"]) %></td><td class="num"><%= report["average_latency_sec"] %>с</td><td class="num"><%= report["distribution"].values.sum { |v| v["deviation_pp"].abs }.round(1) %> п.п.</td><td class="num"><%= report["volume_distribution"].values.sum { |v| v["deviation_pp"].to_f.abs }.round(1) %> п.п.</td></tr><% end %></tbody></table></div></section><% end %>
<section class="card panel"><div class="section-head"><h2>Формальный выбор</h2></div><p class="formula">score(provider) = Σ scoreᵢ(projected state) × weightᵢ / Σ weightᵢ</p><p>Hard constraints всегда применяются до scoring. При равном combined score сравниваются policy priorities, затем <code>provider.priority</code>, затем стабильный <code>payment_system</code>. Случайность не участвует в выборе.</p></section>
