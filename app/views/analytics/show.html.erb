<%= render "shared/page_head", eyebrow: "History & insights", title: "Аналитика", subtitle: "История описывает прошлое, но не меняет актуальные hard filters." %>
<section><div class="section-head"><div><p class="eyebrow">operations_history.csv</p><h2>Snapshot vs empirical</h2></div><span class="pill pill--info">descriptive</span></div><div class="table-wrap card"><table><thead><tr><th>Provider</th><th class="num">Samples</th><th class="num">Approved</th><th class="num">Empirical</th><th class="num">Avg latency</th><th>Result mix</th></tr></thead><tbody><% @history_analytics.each do |name, row| %><tr><td class="mono"><%= name %></td><td class="num"><%= row["operations"] %></td><td class="num"><%= row["approved"] %></td><td class="num"><%= pct(row["empirical_conversion"] * 100) %></td><td class="num"><%= row["average_latency_sec"] %>с</td><td><%= row["result_mix"].map { |k,v| "#{k}: #{v}" }.join(" · ") %></td></tr><% end %></tbody></table></div></section>
<% if @run %><section class="grid grid--2"><article class="card panel"><div class="section-head"><h2>Rule-based insights</h2></div><div class="insights"><% @run.report.fetch("recommendation_details", []).each do |item| %><div class="insight"><span class="pill pill--<%= item['severity'] == 'warning' ? 'warn' : 'info' %>"><%= item["severity"] %></span><div><strong><%= item["provider"] %></strong><p><%= item["evidence"] %> → <%= item["proposed_action"] %></p></div></div><% end %></div></article><article class="card panel"><div class="section-head"><h2>Target exceptions</h2></div><% @run.report.fetch("target_exceptions", []).each do |item| %><div class="exception"><strong><%= item["provider"] %> · <%= item["metric"] %></strong><b><%= item["deviation_pp"] %> п.п.</b><p><%= item["explanation"] %></p></div><% end %></article></section><% end %>
<section><div class="section-head"><h2>Сравнение запусков</h2></div><%= render "shared/run_table", runs: @runs %></section>
