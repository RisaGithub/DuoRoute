<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DuoRoute · Routing Intelligence" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="DuoRoute">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="shell topbar__inner">
        <%= link_to root_path, class: "brand" do %><span class="brand__mark">D</span><span>DuoRoute</span><% end %>
        <nav class="nav" aria-label="Основная навигация">
          <%= navigation_link "Обзор", root_path, controllers: "dashboard" %>
          <%= navigation_link "Запуски", runs_path, controllers: "routing_runs" %>
          <%= navigation_link "Провайдеры", providers_path, controllers: "providers" %>
          <%= navigation_link "Strategy Lab", strategies_path, controllers: "strategies" %>
          <%= navigation_link "Аналитика", analytics_path, controllers: "analytics" %>
          <%= navigation_link "Генератор", generator_path, controllers: "generators" %>
          <%= navigation_link "Методология", methodology_path, controllers: "methodology" %>
        </nav>
        <%= link_to "Новый запуск", new_run_path, class: "btn btn--primary topbar__action" %>
      </div>
    </header>
    <main class="shell page"><%= yield %></main>
    <footer class="shell footer"><span>DuoTech · Hack.Genesis 2026</span><span>Offline-first · Ruby <%= RUBY_VERSION %></span></footer>
  </body>
</html>
