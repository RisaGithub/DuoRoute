<%= render "shared/page_head", eyebrow: "Run ##{@run.id}", title: @run.name, subtitle: "#{@run.preset} · seed #{@run.seed} · #{@run.timeout_mode}" %>

<section class="run-status card panel" data-controller="run-progress" data-run-progress-url-value="<%= progress_run_path(@run) %>" data-terminal="<%= %w[completed failed].include?(@run.status) %>">
  <div class="run-status__top"><span class="pill pill--<%= status_class(@run.status) %>"><%= icon_label(@run.status) %></span><strong data-run-progress-target="label"><%= @run.processed %>/<%= @run.total %> · <%= @run.progress_pct %>% · <%= @run.elapsed_seconds %> с</strong></div>
  <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= @run.progress_pct %>"><span data-run-progress-target="bar" style="width:<%= @run.progress_pct %>%"></span></div>
  <p class="event" data-run-progress-target="event"><%= @run.last_event || "В очереди" %></p>
  <p class="alert alert--error" data-run-progress-target="error" <%= "hidden" unless @run.status == "failed" %>><%= @run.error_message %></p>
</section>

<% if @run.status == "completed" %>
  <% report = @run.report %>
  <div class="toolbar">
    <% { "decisions" => "Decisions JSON", "report" => "Report JSON", "config" => "Config", "manifest" => "Manifest" }.each do |artifact, label| %>
      <%= render "artifact_actions", run: @run, artifact: artifact, label: label %>
    <% end %>
  </div>
  <section class="kpis kpis--4"><article class="kpi card"><span><%= icon_label("Approval") %></span><strong><%= pct(report["approval_rate_pct"]) %></strong></article><article class="kpi card"><span><%= icon_label("Fallback") %></span><strong><%= pct(report["fallback_rate_pct"]) %></strong></article><article class="kpi card"><span><%= icon_label("Latency") %></span><strong><%= report["average_latency_sec"] %>с</strong></article><article class="kpi card"><span><%= icon_label("Рекомендации") %></span><strong><%= report.fetch("recommendations", []).length %></strong></article></section>

  <section><div class="section-head"><div><p class="eyebrow">Replay queue</p><h2><%= icon_label("Решения") %></h2></div><span class="hint">Кликните для полного объяснения</span></div>
    <div class="table-wrap card"><table><thead><tr><th>#</th><th>Operation</th><th>Provider</th><th>Result</th><th class="num">Amount</th><th class="num">Latency</th><th>Fallback</th></tr></thead><tbody>
    <% @run.decisions.each_with_index do |decision, index| operation = @run.operations.find { |item| item["operation_id"] == decision["operation_id"] } %>
      <tr><td class="muted"><%= index + 1 %></td><td><%= link_to decision["operation_id"], operation_run_path(@run, decision["operation_id"]), class: "table-link" %></td><td class="mono"><%= decision["selected_provider"] %></td><td><span class="pill pill--<%= status_class(decision['simulated_result']) %>"><%= icon_label(decision["simulated_result"]) %></span></td><td class="num mono"><%= money(operation["amount"]) %></td><td class="num mono"><%= decision["latency_sec"] %>с</td><td><%= decision["fallback_used"] ? "да" : "—" %></td></tr>
    <% end %></tbody></table></div>
  </section>

  <section class="grid grid--2"><article class="card panel"><div class="section-head"><h2><%= icon_label("Рекомендации") %></h2></div><div class="insights"><% report.fetch("recommendation_details", []).each do |item| %><div class="insight"><span class="pill pill--<%= item['severity'] == 'warning' ? 'warn' : 'info' %>"><%= item["severity"] %></span><div><strong><%= item["provider"] %> · <%= item["proposed_action"] %></strong><p><%= item["evidence"] %>. <%= item["rationale"] %>.</p></div></div><% end %><% if report.fetch("recommendation_details", []).empty? %><p class="empty">Пороговые правила не нашли существенных отклонений.</p><% end %></div></article>
  <article class="card panel"><div class="section-head"><h2><%= icon_label("Воспроизводимость") %></h2></div><dl class="kv"><% report.fetch("reproducibility", {}).each do |key, value| %><dt><%= key %></dt><dd class="mono"><%= value.to_s.length > 28 ? "#{value.to_s.first(12)}…#{value.to_s.last(8)}" : value %></dd><% end %></dl></article></section>
<% elsif @run.status == "failed" %>
  <section class="empty-state card"><h2><%= icon_label("Запуск остановлен безопасно") %></h2><p><%= @run.error_message %></p><%= link_to icon_label("Исправить вход"), new_run_path, class: "btn" %></section>
<% else %>
  <section class="skeleton-grid" aria-label="Загрузка"><div class="skeleton card"></div><div class="skeleton card"></div><div class="skeleton card"></div></section>
<% end %>

<section class="card panel"><h2><%= icon_label("Параметры и воспроизводимость") %></h2><p>Источник симуляции: <%= @run.config.dig("simulation", "source") || @run.simulator_mode %> · seed <%= @run.seed %> · timeout <%= @run.timeout_mode %></p><p>Сохранены собственные providers, operations, history, outcomes и настройки. SHA-256 ниже относятся к сохранённым данным.</p><details><summary><%= icon_label("Полная итоговая конфигурация и пользовательские изменения", "settings") %></summary><pre class="code-input"><%= DuoRoute.pretty_json(@run.config) %></pre></details><details><summary><%= icon_label("Manifest и SHA-256 входов", "settings") %></summary><pre class="code-input"><%= DuoRoute.pretty_json(@run.manifest) %></pre></details><%= link_to icon_label("Обзор этого запуска"), root_path(run_id: @run.id), class: "btn" if @run.status == "completed" %></section>
<%= render "shared/report_summary", report: @run.report if @run.status == "completed" %>
<section class="card panel"><h2><%= icon_label("Исходные файлы сохранённого запуска") %></h2><div class="toolbar"><% %w[providers operations history outcomes].each do |artifact| %><%= render "artifact_actions", run: @run, artifact: artifact, label: artifact %><% end %></div><details><summary><%= icon_label("Имена файлов, размеры и SHA-256", "settings") %></summary><pre class="code-input"><%= DuoRoute.pretty_json(@run.config.fetch("input_metadata", {})) %></pre></details></section>
<section class="card panel"><h2><%= icon_label("История и параметры ответов") %></h2><p>История описывает загруженные прошлые операции. Применённые вероятности симуляции сохранены отдельно.</p><details><summary><%= icon_label("Статистика истории и применённые профили", "settings") %></summary><pre class="code-input"><%= DuoRoute.pretty_json(@run.report.slice("history_analytics", "simulation")) %></pre></details></section>
