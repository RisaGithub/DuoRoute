<%= render "shared/page_head", eyebrow: "Run wizard · 01/03", title: "Новый запуск", subtitle: "Upload или ручное редактирование используют один и тот же строгий Ruby core." %>

<% if @issues.present? %>
  <section class="alert alert--error"><strong>Вход не прошёл валидацию</strong><ul><% @issues.each do |issue| %><li><code><%= issue.path %></code> — <%= issue.message %></li><% end %></ul></section>
<% end %>

<%= form_with url: runs_path, multipart: true, class: "wizard", data: { controller: "config" } do |form| %>
  <section class="card panel">
    <div class="section-head"><div><p class="step">01</p><h2>Входные данные</h2><p class="hint">Файл имеет приоритет над текстовым полем. Лимит 10 МБ, только локальный разбор.</p></div></div>
    <div class="form-grid form-grid--2">
      <label class="field"><span>Название запуска</span><%= text_field_tag :name, nil, class: "input", placeholder: "Public demo · balanced" %></label>
      <label class="field"><span>Providers JSON</span><%= file_field_tag :providers_file, accept: ".json,application/json", class: "file" %></label>
      <label class="field"><span>Operations JSON</span><%= file_field_tag :operations_file, accept: ".json,application/json", class: "file" %></label>
      <label class="field"><span>History CSV · optional</span><%= file_field_tag :history_file, accept: ".csv,text/csv", class: "file" %></label>
      <label class="field"><span>Config YAML / JSON</span><%= file_field_tag :config_file, accept: ".yml,.yaml,.json", class: "file" %></label>
      <label class="field"><span>Scripted outcomes · optional</span><%= file_field_tag :outcomes_file, accept: ".json,application/json", class: "file" %></label>
    </div>
    <details class="manual" open><summary>Ручной режим / preview входа</summary>
      <div class="form-grid form-grid--2">
        <label class="field"><span>providers.json</span><%= text_area_tag :providers_text, @defaults[:providers], class: "code-input", rows: 12, spellcheck: false %></label>
        <label class="field"><span>operations.json</span><%= text_area_tag :operations_text, @defaults[:operations], class: "code-input", rows: 12, spellcheck: false %></label>
        <label class="field"><span>routing config</span><%= text_area_tag :config_text, @defaults[:config], class: "code-input", rows: 12, spellcheck: false, data: { config_target: "config" } %></label>
        <label class="field"><span>history.csv · optional</span><%= text_area_tag :history_text, @defaults[:history], class: "code-input", rows: 12, spellcheck: false %></label>
        <label class="field"><span>outcomes.json · scripted only</span><%= text_area_tag :outcomes_text, @defaults[:outcomes], class: "code-input", rows: 10, spellcheck: false %></label>
      </div>
    </details>
  </section>

  <section class="card panel">
    <div class="section-head"><div><p class="step">02</p><h2>Стратегия и симуляция</h2></div><span class="pill pill--info">deterministic</span></div>
    <div class="form-grid form-grid--3">
      <label class="field"><span>Preset</span><%= select_tag :preset, options_for_select(RoutingRun::PRESETS, params[:preset] || "balanced"), class: "select" %></label>
      <label class="field"><span>Timeout policy</span><%= select_tag :timeout_mode, options_for_select(%w[fallback_on_timeout hold_until_status], params[:timeout_mode] || "fallback_on_timeout"), class: "select" %></label>
      <label class="field"><span>Simulator</span><%= select_tag :simulator_mode, options_for_select(%w[scripted seeded], params[:simulator_mode] || "scripted"), class: "select" %></label>
      <label class="field"><span>Seed</span><%= number_field_tag :seed, params[:seed] || 42, class: "input", min: 0 %></label>
    </div>
    <div class="weight-head"><label class="check"><%= check_box_tag :custom_weights, "1", false %><strong>Переопределить preset этими весами</strong></label><span>Σ <b data-config-target="sum">0</b></span></div>
    <div class="weight-grid">
      <% DuoRoute::Validation::InputValidator::POLICY_NAMES.each do |policy| %>
        <label class="field"><span><%= policy %></span><%= number_field_tag "policy_weights[#{policy}]", @weight_defaults.fetch(policy, 0), min: 0, max: 10, step: 0.1, class: "input mono", data: { config_target: "weight", action: "input->config#normalize" } %></label>
      <% end %>
    </div>
    <p class="alert alert--error" data-config-target="warning" hidden>Все policies выключены: сумма весов должна быть больше нуля.</p>
    <div class="formula">combined = Σ(normalized policy score × weight) / Σ(active weights)</div>
    <p class="hint">Веса редактируются в config. Отсутствующее optional-поле отключает только свою policy. Tie-break: policy priority → provider priority → payment_system.</p>
    <div class="toolbar"><button type="button" class="btn" data-action="config#save">Сохранить конфигурацию локально</button><button type="button" class="btn" data-action="config#restore">Восстановить</button><button type="button" class="btn" data-action="config#download">Скачать YAML</button></div>
  </section>

  <section class="wizard__actions"><div><strong>03 · запуск</strong><p class="hint">Сначала выполняется полная валидация. Невалидный input не создаёт частичного результата.</p></div><%= form.submit "Запустить маршрутизацию", class: "btn btn--primary btn--large" %></section>
<% end %>
