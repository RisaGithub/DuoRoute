<% selected = @decision["selected_provider"] %>
<%= render "shared/page_head", eyebrow: "#{@run.name} · operation", title: "Почему выбран #{selected}", subtitle: "#{@decision['operation_id']} · #{money(@operation['amount'])} · #{@operation['bank']} · #{masked_phone(@operation)}" %>

<section class="decision-lead card"><div><span class="pill pill--<%= status_class(@decision['simulated_result']) %>"><%= @decision["simulated_result"] %></span><h2><%= selected %> получил итоговый маршрут</h2><p>Combined score <strong><%= @decision["score"] || "fallback" %></strong>. <%= @decision["fallback_used"] ? "External pool исчерпан — применён self-provider." : "Все hard constraints соблюдены; soft policies разрешили выбор." %></p></div><div class="score-orbit"><strong><%= @decision["score"] ? (@decision["score"] * 100).round : "F" %></strong><span>score</span></div></section>

<section class="grid grid--2">
  <article class="card panel"><div class="section-head"><div><p class="eyebrow">Attempt timeline</p><h2>Каскад и fallback</h2></div></div><ol class="timeline"><% @decision["attempts"].each do |attempt| %><li class="timeline__item timeline__item--<%= attempt['decision'] %>"><span class="timeline__dot"></span><div><strong><%= attempt["provider"] %></strong><span class="pill pill--<%= attempt['decision'] == 'selected' ? 'ok' : 'muted' %>"><%= attempt["decision"] %></span><p><code><%= attempt["reason"] %></code><% if attempt["details"] %> · <%= attempt["details"] %><% end %></p><small><%= [attempt["result"], ("#{attempt['latency_sec']}с" if attempt["latency_sec"])].compact.join(" · ") %></small></div></li><% end %></ol></article>
  <article class="card panel"><div class="section-head"><div><p class="eyebrow">Explainability waterfall</p><h2>Вклад policies</h2></div></div><div class="waterfall"><% @decision.fetch("score_breakdown", {}).sort_by { |_, v| -v["contribution"] }.each do |name, score| %><div class="waterfall__row"><div><strong><%= name %></strong><small><%= score["explanation"] %></small></div><span class="bar"><i style="width:<%= score['normalized_value'].to_f * 100 %>%"></i></span><b>+<%= score["contribution"] %></b></div><% end %></div></article>
</section>

<% constraint_labels = %w[status min_amount max_amount daily_limit in_progress_count in_progress_amount bank margin requisites rpm] %>
<section class="card panel"><div class="section-head"><div><p class="eyebrow">Hard gate</p><h2>Матрица ограничений</h2></div></div><div class="table-wrap"><table><thead><tr><th>Provider</th><th>Итог</th><% @decision.dig("constraint_matrix")&.values&.first&.fetch("checks", [])&.each_with_index do |_check, index| %><th><%= constraint_labels[index] || "check_#{index + 1}" %></th><% end %></tr></thead><tbody><% @decision.fetch("constraint_matrix", {}).each do |provider, evaluation| %><tr><td class="mono"><%= provider %></td><td><span class="pill pill--<%= evaluation['eligible'] ? 'ok' : 'fail' %>"><%= evaluation['eligible'] ? 'eligible' : 'blocked' %></span></td><% evaluation["checks"].each do |check| %><td title="<%= check['explanation'] %>"><%= check["eligible"] ? "✓" : "× #{check['code']}" %></td><% end %></tr><% end %></tbody></table></div></section>

<section class="grid grid--2"><article class="card panel"><div class="section-head"><h2>State до → после</h2></div><div class="table-wrap"><table><thead><tr><th>Provider</th><th class="num">Daily before</th><th class="num">Daily after</th><th class="num">RPM</th></tr></thead><tbody><% @decision["state_before"].each do |name, state| after = @decision["state_after"][name] %><tr><td class="mono"><%= name %></td><td class="num"><%= money(state["daily_approved_amount"]) %></td><td class="num"><%= money(after["daily_approved_amount"]) %></td><td class="num"><%= after["requests_last_minute"] %></td></tr><% end %></tbody></table></div></article><article class="card panel"><div class="section-head"><h2>Конфликты и tie-break</h2></div><p class="formula"><%= @decision["tie_break_rule"] %></p><pre class="json"><%= JSON.pretty_generate(@decision.fetch("conflicts", [])) %></pre></article></section>
<details class="card raw"><summary>Raw decision JSON</summary><pre class="json"><%= JSON.pretty_generate(@decision) %></pre></details>
