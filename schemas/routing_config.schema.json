          "in_progress_count": {
            "type": "integer",
            "minimum": 0
          },
          "in_progress_amount_limit": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "in_progress_amount": {
            "type": "number",
            "minimum": 0
