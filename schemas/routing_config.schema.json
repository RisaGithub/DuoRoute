          },
          "volume_share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "daily_turnover_min": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "daily_turnover_max": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "preferred_amount_min": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "preferred_amount_max": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "payment_system": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "banks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "exclude_banks": {
            "type": "boolean"
          },
          "allow_negative_agreement": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "history",
            "provider_snapshot",
            "custom",
            "scripted"
          ]
        },
        "expired_rate": {
          "type": "number",
          "minimum": 0
        },
        "minimum_samples": {
          "type": "integer",
          "minimum": 1
        },
        "latency_method": {
          "enum": [
            "mean",
            "median"
          ]
        },
        "failure_expired_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency_spread_sec": {
          "type": "number",
          "minimum": 0
