          "conversion_24h": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "avg_latency_sec": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_margin_pct": {
            "type": "number",
            "minimum": 0
          },
          "merchant_margin_pct": {
            "type": "number",
            "minimum": 0
