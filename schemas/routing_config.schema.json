{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DuoRoute routing_config",
  "description": "Structural contract. Cross-field constraints, identity, exact money, state, and configuration semantics require the input validator or independent submission audit.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "routing": {
      "type": "object",
      "properties": {
        "fallback_provider": {
          "type": "string",
          "minLength": 1
        },
        "timeout_mode": {
          "enum": [
            "fallback_on_timeout",
            "hold_until_status"
          ]
        },
        "default_strategy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "presets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "weights": {
            "type": "object",
            "properties": {
              "count_share": {
                "type": "number",
                "minimum": 0
              },
              "volume_share": {
                "type": "number",
                "minimum": 0
              },
              "cascade": {
                "type": "number",
                "minimum": 0
              },
              "preferred_amount": {
                "type": "number",
                "minimum": 0
              },
              "conversion": {
                "type": "number",
                "minimum": 0
              },
              "load_safe": {
                "type": "number",
                "minimum": 0
              },
              "intensity": {
                "type": "number",
                "minimum": 0
              },
              "turnover_commitment": {
                "type": "number",
                "minimum": 0
              },
              "economy": {
                "type": "number",
                "minimum": 0
              },
              "latency": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "policy_priorities": {
            "type": "array",
            "items": {
              "enum": [
                "count_share",
                "volume_share",
                "cascade",
                "preferred_amount",
                "conversion",
                "load_safe",
                "intensity",
                "turnover_commitment",
                "economy",
                "latency"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "weights"
        ],
        "additionalProperties": false
      }
    },
    "provider_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "traffic_percentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "limit_amount_min": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "limit_amount_max": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "daily_amount_limit": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "daily_approved_amount": {
            "type": "number",
            "minimum": 0
